---
import "../styles/global.css";

const site = {
  title: "The Saltine Reborn",
  author: "Matthew T. Caffrey",
  publisher: "Hallowfield Publishing Group",
  description:
    "Begin reading The Saltine Reborn, a dark cinematic fantasy serial by Matthew T. Caffrey from Hallowfield Publishing Group.",
  cover: "/assets/saltine-cover.jpg",
  logo: "/assets/hallowfield-logo-gold.png",
  socialImage: "/assets/social-preview.jpg"
};

const release = {
  prologueHref: "/chapters/prologue/",
  chapterOneHref: "/chapters/chapter-1/",
  chapterTwoHref: "/chapters/chapter-2/",
  chapterTwoReleaseAt: "2026-06-26T19:00:00-04:00",
  chapterThreeHref: "/chapters/chapter-3/",
  chapterThreeReleaseAt: "2026-06-27T19:00:00-04:00",
  saltinesHref: "/books/The-Saltines.pdf",
  ritzHref: "/books/The-Ritz-Strike-Back.pdf"
};

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL(site.socialImage, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="access-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title} | {site.publisher}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#080706" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${site.title} | ${site.publisher}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${site.title} | ${site.publisher}`} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script src="/access-gate.js" defer></script>
    <script src="/chapter-countdown.js" defer></script>
  </head>
  <body>
    <main class="page-shell" aria-labelledby="site-title">
      <header class="masthead" aria-label="Publisher">
        <div class="imprint">
          <img
            class="publisher-logo"
            src={site.logo}
            width="449"
            height="396"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <span>{site.publisher}</span>
        </div>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current="page">Reading Room</a>
          <a href="/library/">Library</a>
        </nav>
      </header>

      <section class="current-release" aria-labelledby="site-title">
        <figure class="cover-wrap">
          <img
            class="cover"
            src={site.cover}
            alt="Cover art for The Saltine Reborn by Matthew T. Caffrey"
            loading="eager"
            decoding="async"
          />
        </figure>

        <div class="current-release-copy">
          <p class="kicker">Current Release</p>
          <h1 class="title" id="site-title">{site.title}</h1>
          <p class="author">Prologue + Chapter One</p>
          <p class="release-note">
            Begin reading The Saltine Reborn with the Prologue and Chapter One.
            New chapters will be released as they are completed.
          </p>
          <div class="release-actions current-release-actions">
            <a class="archive-button" href={release.prologueHref}>
              Read Prologue
            </a>
            <a class="archive-button" href={release.chapterOneHref}>
              Read Chapter One
            </a>
          </div>
          <div
            class="chapter-release-gate homepage-release-gate"
            data-release-at={release.chapterTwoReleaseAt}
            aria-live="polite"
          >
            <div class="countdown-state compact-countdown" data-countdown-state>
              <p class="release-note">Chapter Two opens at 7:00 PM Eastern tonight.</p>
              <div class="countdown-grid">
                <span>
                  <strong data-countdown-days>--</strong>
                  <small>Days</small>
                </span>
                <span>
                  <strong data-countdown-hours>--</strong>
                  <small>Hours</small>
                </span>
                <span>
                  <strong data-countdown-minutes>--</strong>
                  <small>Minutes</small>
                </span>
                <span>
                  <strong data-countdown-seconds>--</strong>
                  <small>Seconds</small>
                </span>
              </div>
            </div>
            <div class="release-actions current-release-actions">
              <a class="archive-button" href={release.chapterTwoHref} hidden data-release-link>
                Read Chapter Two
              </a>
            </div>
          </div>
          <div
            class="chapter-release-gate homepage-release-gate"
            data-release-at={release.chapterThreeReleaseAt}
            aria-live="polite"
          >
            <div class="countdown-state compact-countdown" data-countdown-state>
              <p class="release-note">Chapter Three opens at 7:00 PM Eastern tonight.</p>
              <div class="countdown-grid">
                <span>
                  <strong data-countdown-days>--</strong>
                  <small>Days</small>
                </span>
                <span>
                  <strong data-countdown-hours>--</strong>
                  <small>Hours</small>
                </span>
                <span>
                  <strong data-countdown-minutes>--</strong>
                  <small>Minutes</small>
                </span>
                <span>
                  <strong data-countdown-seconds>--</strong>
                  <small>Seconds</small>
                </span>
              </div>
            </div>
            <div class="release-actions current-release-actions">
              <a class="archive-button" href={release.chapterThreeHref} hidden data-release-link>
                Read Chapter Three
              </a>
            </div>
          </div>
          <div class="release-actions secondary-release-actions">
            <a class="archive-button" href="/library/">Library</a>
            <a class="archive-button" href={release.saltinesHref} target="_blank" rel="noopener">
              The Saltines
            </a>
            <a class="archive-button" href={release.ritzHref} target="_blank" rel="noopener">
              The Ritz Strike Back
            </a>
          </div>
        </div>
      </section>

      <footer class="footer">
        <span>{site.publisher}</span>
        <span class="footer-line">The Saltine Reading Room</span>
      </footer>
    </main>
  </body>
</html>
