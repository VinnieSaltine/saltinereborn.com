---
import { existsSync, statSync } from "node:fs";
import { join } from "node:path";
import { chapters } from "../data/chapters";
import "../styles/global.css";

const site = {
  title: "The Saltines Library",
  publisher: "Hallowfield Publishing Group",
  description:
    "A private literary archive for The Saltines universe, including earlier books, collected works, and the continuing Saltine Reborn serial.",
  logo: "/assets/hallowfield-logo-gold.png",
  socialImage: "/assets/social-preview.jpg"
};

const archiveItems = [
  {
    sequence: "Book 1",
    title: "The Saltines",
    cover: "/assets/the-saltines-placeholder.svg",
    description:
      "The first recovered volume in the Saltines record. Friendship, firelight, and the earliest shape of the strange history that refuses to stay buried.",
    action: "Read / Download",
    href: "/books/The-Saltines.pdf",
    filePath: "public/books/The-Saltines.pdf"
  },
  {
    sequence: "Book 2",
    title: "The Ritz Strike Back",
    cover: "/assets/the-ritz-strike-back-placeholder.svg",
    description:
      "The second entry in the archive, following the aftermath, reprisals, and unfinished business that carried the legend forward.",
    action: "Read / Download",
    href: "/books/The-Ritz-Strike-Back.pdf",
    filePath: "public/books/The-Ritz-Strike-Back.pdf"
  },
  {
    sequence: "Book 3",
    title: "Saltine Reborn",
    cover: "/assets/saltine-cover.jpg",
    description:
      "Twenty years after the bonfire, the story continues across Rome, memory, and the shadow of a sacrifice that may not have held.",
    status: "In Progress",
    progressLabel: "Chapter Twenty-Six",
    progressDetail: "Available Now",
    progressValue: 100
  }
];

const futureCollections = [
  "Side Stories",
  "Character Guides",
  "Timelines",
  "Maps",
  "Bonus Content"
];

function formatFileSize(filePath: string) {
  const absolutePath = join(process.cwd(), filePath);

  if (!existsSync(absolutePath)) {
    return null;
  }

  const bytes = statSync(absolutePath).size;
  const megabytes = bytes / 1024 / 1024;

  if (megabytes >= 1) {
    return `${megabytes.toFixed(1)} MB`;
  }

  return `${Math.max(1, Math.round(bytes / 1024))} KB`;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL(site.socialImage, Astro.site).toString();
const chapterItems = chapters.map((chapter) => ({
  label: `Read ${chapter.releaseLabel}`,
  href: `/chapters/${chapter.slug}/`,
  fileSize: formatFileSize(`public${chapter.pdfHref}`)
}));
---

<!doctype html>
<html lang="en" class="access-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title} | {site.publisher}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#080706" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${site.title} | ${site.publisher}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${site.title} | ${site.publisher}`} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script src="/access-gate.js" defer></script>
  </head>
  <body>
    <main class="page-shell archive-shell" aria-labelledby="library-title">
      <header class="masthead" aria-label="Publisher">
        <div class="imprint">
          <img
            class="publisher-logo"
            src={site.logo}
            width="449"
            height="396"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <span>{site.publisher}</span>
        </div>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Reading Room</a>
          <a href="/library/" aria-current="page">Library</a>
        </nav>
      </header>

      <section class="archive-intro">
        <p class="kicker">Private Collection</p>
        <h1 class="archive-title" id="library-title">The Saltines Library</h1>
        <p class="archive-lede">
          Earlier volumes, recovered fragments, and the living serial record of
          a universe still opening its locked rooms.
        </p>
      </section>

      <section class="release-countdown" aria-labelledby="released-chapters-title">
        <div>
          <p class="kicker">The Saltine Reborn</p>
          <h2 id="released-chapters-title">Released Chapters</h2>
          <p class="release-note">The Reading Room is open. New chapters will be added here as they arrive.</p>
        </div>

        <div class="release-actions">
          {chapterItems.map((chapter) => (
            <a class="archive-button" href={chapter.href}>
              {chapter.label}
              <span class="button-meta">PDF{chapter.fileSize ? ` · ${chapter.fileSize}` : ""}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="archive-grid" aria-label="Collected works">
        {
          archiveItems.map((item) => (
            <article class="archive-volume">
              <figure class="archive-cover-wrap">
                <img
                  class="archive-cover"
                  src={item.cover}
                  alt={`Cover for ${item.title}`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="archive-record">
                <p class="volume-sequence">{item.sequence}</p>
                <h2>{item.title}</h2>
                {item.status && <p class="status-pill">{item.status}</p>}
                <p>{item.description}</p>
                {item.progressLabel && (
                  <div class="progress-record" aria-label="Chapter progress">
                    <div class="progress-row">
                      <span>{item.progressLabel}</span>
                      <span>{item.progressDetail}</span>
                    </div>
                    <div
                      class="progress-track"
                      aria-hidden="true"
                      style={`--progress: ${item.progressValue}%`}
                    >
                      <span></span>
                    </div>
                  </div>
                )}
                {item.action && (
                  <div class="archive-action">
                    <a class="archive-button" href={item.href} target="_blank" rel="noopener">
                      {item.action}
                    </a>
                    <span class="file-meta">
                      PDF{item.filePath && formatFileSize(item.filePath) ? ` · ${formatFileSize(item.filePath)}` : ""}
                    </span>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </section>

      <section class="future-shelves" aria-label="Future archive sections">
        <p class="kicker">Reserved Shelves</p>
        <div class="shelf-list">
          {futureCollections.map((collection) => <span>{collection}</span>)}
        </div>
      </section>

      <footer class="footer">
        <span>{site.publisher}</span>
        <span class="footer-line">The collected Saltines record</span>
      </footer>
    </main>
  </body>
</html>
