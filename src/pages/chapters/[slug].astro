---
import { chapters } from "../../data/chapters";
import "../../styles/global.css";

export function getStaticPaths() {
  return chapters.map((chapter) => ({
    params: { slug: chapter.slug },
    props: { chapter }
  }));
}

const { chapter } = Astro.props;

const site = {
  title: `${chapter.releaseLabel} | The Saltine Reborn`,
  publisher: "Hallowfield Publishing Group",
  description: `${chapter.releaseLabel} from The Saltine Reborn by Matthew T. Caffrey.`,
  cover: "/assets/saltine-cover.jpg",
  logo: "/assets/hallowfield-logo-gold.png",
  socialImage: "/assets/social-preview.jpg"
};

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL(site.socialImage, Astro.site).toString();
---

<!doctype html>
<html lang="en" class="access-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title} | {site.publisher}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#080706" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${site.title} | ${site.publisher}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${site.title} | ${site.publisher}`} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script src="/access-gate.js" defer></script>
    <script src="/discussion.js" defer></script>
  </head>
  <body>
    <main class="page-shell chapter-shell" aria-labelledby="chapter-title">
      <header class="masthead" aria-label="Publisher">
        <div class="imprint">
          <img
            class="publisher-logo"
            src={site.logo}
            width="449"
            height="396"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <span>{site.publisher}</span>
        </div>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Reading Room</a>
          <a href="/library/">Library</a>
        </nav>
      </header>

      <article class="chapter-entry">
        <figure class="chapter-cover-wrap">
          <img
            class="chapter-cover"
            src={site.cover}
            alt="Cover art for The Saltine Reborn by Matthew T. Caffrey"
            loading="eager"
            decoding="async"
          />
        </figure>

        <div class="chapter-copy">
          <p class="kicker">{chapter.sequence}</p>
          <h1 class="chapter-title" id="chapter-title">{chapter.title}</h1>
          <p class="author">{chapter.releaseLabel}</p>
          <p class="release-note">{chapter.description}</p>
          <div class="release-actions chapter-actions">
            <a class="archive-button" href={chapter.pdfHref} target="_blank" rel="noopener">
              Open PDF
            </a>
            <a class="archive-button" href="/library/">Library</a>
          </div>
        </div>
      </article>

      <section
        class="discussion"
        aria-labelledby="discussion-title"
        data-chapter-discussion
        data-chapter-slug={chapter.slug}
      >
        <div class="discussion-heading">
          <h2 id="discussion-title">Discussion</h2>
        </div>

        <div class="discussion-auth" data-discussion-auth>
          <p class="discussion-message" data-auth-message>
            Sign in with your reader name and password to join the discussion.
          </p>
          <form class="discussion-login" data-login-form>
            <label>
              Reader name
              <input name="name" autocomplete="username" required />
            </label>
            <label>
              Password
              <input name="password" type="password" autocomplete="current-password" required />
            </label>
            <button type="submit">Enter Discussion</button>
          </form>
        </div>

        <div class="discussion-room" data-discussion-room hidden>
          <div class="discussion-reader">
            <span data-reader-label></span>
            <button type="button" data-reader-logout>Switch reader</button>
          </div>

          <ol class="comment-list" data-comment-list></ol>

          <form class="comment-form" data-comment-form>
            <label for={`comment-${chapter.slug}`}>Add a comment</label>
            <textarea
              id={`comment-${chapter.slug}`}
              name="body"
              rows="5"
              maxlength="2000"
              placeholder="Leave a comment..."
              required
            ></textarea>
            <button type="submit">Post Comment</button>
            <p class="discussion-message" data-comment-message></p>
          </form>
        </div>
      </section>

      <footer class="footer">
        <span>{site.publisher}</span>
        <span class="footer-line">The Saltine Reading Room</span>
      </footer>
    </main>
  </body>
</html>
